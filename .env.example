# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me_to_your_password
DB_NAME=lunarpunk_db

# Security (Secrets MUST be changed in production)
JWT_SECRET=change_me_to_a_secure_random_string_min_10_chars
QR_SECRET=change_me_to_a_secure_hmac_secret_min_10_chars

# Third Party Services
MP_ACCESS_TOKEN=your_mercadopago_access_token
API_KEY=your_google_gemini_api_key
