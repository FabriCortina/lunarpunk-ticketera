PORT=3100
NODE_ENV=development
LOG_LEVEL=info

# Postgres local (docker-compose)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lunarpunk_db

# Security
JWT_SECRET=change_me_please
QR_SECRET=change_me_please
QR_TTL_SECONDS=0

# Third Party
MP_ACCESS_TOKEN=change_me_please
MP_WEBHOOK_SECRET=change_me_please
MP_WEBHOOK_TOLERANCE_SECONDS=300
API_KEY=change_me_please
ADMIN_BOOTSTRAP_SECRET=change_me_please

# Email (Resend) - Recuperación de contraseña
# Sin RESEND_API_KEY el endpoint /api/auth/forgot-password sigue funcionando
# pero no se envía el correo (se loguea un warning).
RESEND_API_KEY=
EMAIL_FROM=LunarPunk <onboarding@resend.dev>
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# App Config
BACKEND_PUBLIC_BASE_URL=http://localhost:3100
FRONTEND_PUBLIC_BASE_URL=http://localhost:3000
# '*' solo es válido en desarrollo. En producción (NODE_ENV=production) el
# servidor rechaza arrancar con '*': debe ser una lista explícita separada por
# comas, p.ej. https://tu-app.up.railway.app,https://tu-dominio.com
ALLOWED_ORIGINS=*
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
