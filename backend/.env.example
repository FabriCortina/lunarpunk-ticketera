# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# URLs
PUBLIC_BASE_URL=https://tu-proyecto.up.railway.app
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,http://localhost:5173

# Database (Railway automatically provides DATABASE_URL)
DATABASE_URL=postgresql://postgres:password@containers-us-west-1.railway.app:5432/railway
# OR manual config for local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lunarpunk_db

# Security
JWT_SECRET=change_me_to_a_secure_random_string_min_10_chars
QR_SECRET=change_me_to_a_secure_hmac_secret_min_10_chars

# Third Party Services
MP_ACCESS_TOKEN=your_mercadopago_access_token
API_KEY=your_google_gemini_api_key